# Copy this file to .env, then put your real values in .env:
#   cp .env.example .env
# This file is public, so keep only placeholders here.
# Values starting with NEXT_PUBLIC_ are visible in the browser, so never put secrets in them.
# Restart `npm run dev` after changing this file.

# Address of the backend API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase, for signing up and logging in. Find both in the Supabase dashboard:
# Project Settings > Data API (URL) and Project Settings > API Keys (publishable key).
# Use the publishable key (sb_publishable_...), never the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
