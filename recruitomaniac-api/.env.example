# Copy this file to .env, then put your real values in .env:
#   cp .env.example .env
# This file is public, so keep only placeholders here.

# Address of the web app. Only this site may call the API from a browser.
# Write it exactly as the browser shows it, without a "/" at the end.
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection, needed from issue #4:
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/recruitomaniac

# The auth provider's keys will be added here in issue #5.
