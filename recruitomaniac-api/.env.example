# Copy this file to .env, then put your real values in .env:
#   cp .env.example .env
# This file is public, so keep only placeholders here.

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/recruitomaniac

# Address of the web app, which will be allowed to call this API
FRONTEND_URL=http://localhost:3000

# Google sign-in (create these in the Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
